# Telegram MTProto API Credentials
# Obtain API_ID and API_HASH from https://my.telegram.org (under 'API development tools')
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Media Download Configuration
# Set to 'true' to download photos, videos, audio, voice messages, and documents
# Set to 'false' to export only metadata and text
DOWNLOAD_MEDIA=false

# Session Configuration
# Telethon will save your authenticated session to <SESSION_NAME>.session
SESSION_NAME=telegram_exporter

# Output Directory (optional, defaults to ./export)
EXPORT_DIR=export
